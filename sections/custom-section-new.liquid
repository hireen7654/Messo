<h1> == New Custom Section == </h1>
{% for block in section.blocks %}
    {% case block.type %}
        {% when 'title' %}
            <h2>Title</h2>            
    {% endcase %}
    <h2>{{ section.settings.label }}</h2>
    <h2>{{ block.type }}</h2>
{% endfor %}

{% schema %}
    {
        "name": "Custom Section New",
        "class": "custom-section-new",
        "blocks": [
            {
                "type": "title",
                "name": "Title",
                "settings": [
                    {
                        "type": "color",
                        "id": "bg_color",
                        "label": "Background Color",
                        "default": "#e9e9e9",
                    },
                    {
                        "type": "color",
                        "id": "txt_color",
                        "label": "Text Color",
                        "default": "#ff0000",
                    },
                ]
            },
            {
                "name": "Text",
                "type": "text"
            }
        ],
        "presets": [
            {
                "name": "Custom Section New",
            }
        ]
    }
{% endschema %}
